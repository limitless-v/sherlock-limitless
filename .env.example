# Application
APP_NAME=Face Search OSINT Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Database (development: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/face_search

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage paths (relative to project root)
STORAGE_UPLOADS=uploads
STORAGE_CACHE=cache
STORAGE_EMBEDDINGS=embeddings
STORAGE_RESULTS=results
STORAGE_LOGS=logs
STORAGE_MODELS=models

# Upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MAX_IMAGE_DIMENSION=4096

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# AI / Inference
AI_DEVICE=cpu
# AI_DEVICE=cuda
AI_USE_GPU=false
AI_MODEL_CACHE=true
AI_LAZY_LOAD=true
INSIGHTFACE_MODEL=buffalo_l
ONNX_PROVIDERS=CPUExecutionProvider
# ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
FACE_DET_CONFIDENCE=0.5
EMBEDDING_DIM=512
SIMILARITY_THRESHOLD=0.6
FAISS_INDEX_PATH=embeddings/faiss.index
FAISS_TOP_K=20

# Search orchestration
# Supported modes: local | internet | hybrid
SEARCH_DEFAULT_MODE=internet
SEARCH_MAX_RESULTS=50

# Internet OSINT (Agent Reach)
AGENT_REACH_ENABLED=false
AGENT_REACH_TIMEOUT_SECONDS=30
AGENT_REACH_MAX_CANDIDATES=10
# Optional explicit CLI path (default: resolved from PATH)
AGENT_REACH_CMD=
# Channel used for keyword queries (URL queries always use web.<url>)
AGENT_REACH_SEARCH_CHANNEL=exa.search
HTTP_USER_AGENT=FaceSearchOSINT/1.0 (+research)

# Research agent crawl policies (Phases 19-22)
AGENT_MAX_PAGES=20
AGENT_MAX_DEPTH=3
AGENT_MAX_IMAGES=50
AGENT_MAX_RUNTIME_SECONDS=120
AGENT_MAX_REQUESTS_PER_DOMAIN=30
AGENT_PER_DOMAIN_MIN_INTERVAL=1.0
AGENT_HTTP_TIMEOUT_SECONDS=10
AGENT_RESPECT_ROBOTS=true
# Comma-separated allowlist (optional; empty = any public host)
AGENT_ALLOW_DOMAINS=

# Optional LLM (Ollama) — off by default
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE=logs/app.log

# Frontend (for docker / docs)
NEXT_PUBLIC_API_URL=http://localhost:8000
